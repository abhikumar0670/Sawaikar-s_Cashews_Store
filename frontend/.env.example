# Frontend Environment Variables Example
# Copy this file to .env and fill in your actual values

# ===================================
# CLERK AUTHENTICATION
# ===================================
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ===================================
# API CONFIGURATION
# ===================================
REACT_APP_API_URL=http://localhost:5000

# For production, use your deployed backend URL:
# REACT_APP_API_URL=https://your-backend-domain.com

# ===================================
# RAZORPAY (Frontend Key)
# ===================================
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ===================================
# NOTES
# ===================================
# 1. All React environment variables MUST start with REACT_APP_
# 2. Restart the development server after changing .env
# 3. NEVER commit the actual .env file to git
# 4. Keep .env in .gitignore

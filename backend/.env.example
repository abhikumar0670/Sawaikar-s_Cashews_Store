# ============================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============ SERVER ============
PORT=5000
NODE_ENV=development
APP_VERSION=2.0.0

# ============ DATABASE ============
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sawaikar-store?retryWrites=true&w=majority

# ============ AUTHENTICATION (Clerk) ============
CLERK_SECRET_KEY=sk_test_xxx...

# ============ PAYMENTS (Razorpay) ============
RAZORPAY_KEY_ID=rzp_test_xxx...
RAZORPAY_KEY_SECRET=xxx...

# ============ EMAIL SERVICE ============
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
GMAIL_REFRESH_TOKEN=1//0xxx...

# ============ AI CHATBOT (Groq) ============
GROQ_API_KEY=gsk_xxx...

# ============ ERROR TRACKING (Sentry) ============
# Get DSN from https://sentry.io/organizations/your-org/
# Format: https://key@sentry.io/projectid
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============ FRONTEND ============
FRONTEND_URL=http://localhost:3000

# ============ ADDITIONAL SETTINGS ============
# Add more environment variables as needed

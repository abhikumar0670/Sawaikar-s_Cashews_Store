# ============================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============ SERVER ============
PORT=5000
NODE_ENV=development
APP_VERSION=2.0.0

# ============ DATABASE ============
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sawaikar-store?retryWrites=true&w=majority
MONGODB_NAME=SawaikarCashew

# ============ AUTHENTICATION (Clerk) ============
CLERK_SECRET_KEY=sk_test_xxx...

# ============ PAYMENTS (Razorpay) ============
RAZORPAY_KEY_ID=rzp_test_xxx...
RAZORPAY_KEY_SECRET=xxx...

# ============ EMAIL SERVICE ============
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
GMAIL_REFRESH_TOKEN=1//0xxx...

# ============ AI CHATBOT (Groq) ============
GROQ_API_KEY=gsk_xxx...
GROQ_MODEL=mixtral-8x7b-32768

# ============ RAG (Retrieval-Augmented Generation) ============
# Enable/disable RAG context retrieval (default: true)
RAG_ENABLED=true

# Pinecone Vector Database Configuration
# Get API key from https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=sawaikar-chat
PINECONE_ENVIRONMENT=gcp-starter

# HuggingFace API (optional - for advanced embedding options)
# Only needed if using HuggingFace Inference API instead of local embeddings
# HUGGINGFACE_API_KEY=hf_xxx...

# ============ ERROR TRACKING (Sentry) ============
# Get DSN from https://sentry.io/organizations/your-org/
# Format: https://key@sentry.io/projectid
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============ FRONTEND ============
FRONTEND_URL=http://localhost:3000

# ============ ADDITIONAL SETTINGS ============
# Add more environment variables as needed

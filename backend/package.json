{
  "name": "sawaikar-cashew-backend",
  "version": "1.0.0",
  "description": "Backend API for Sawaikar's Cashew Store",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedData.js",
    "setup:indexes": "node -e \"require('./config/setupIndexes').createIndexes().then(() => process.exit(0))\"",
    "list:indexes": "node -e \"require('./config/setupIndexes').listIndexes().then(() => process.exit(0))\"",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "cashew",
    "ecommerce",
    "api"
  ],
  "author": "Sawaikar's Cashew Store",
  "license": "ISC",
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.13.23",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.0",
    "googleapis": "^170.0.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.0.3",
    "nodemailer": "^6.9.7",
    "razorpay": "^2.9.6",
    "redis": "^4.6.0",
    "@sentry/node": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.0.0",
    "supertest": "^6.3.0"
  }
}

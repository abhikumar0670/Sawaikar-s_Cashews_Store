# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# ===================================
# DATABASE
# ===================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ===================================
# AUTHENTICATION (Clerk)
# ===================================
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ===================================
# PAYMENT (Razorpay)
# ===================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ===================================
# EMAIL CONFIGURATION
# Choose ONE provider and configure it
# ===================================

# Option 1: Gmail API (Recommended for Gmail users)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
EMAIL_USER=your-email@gmail.com

# Option 2: Mailjet (Recommended for production)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# Option 3: Brevo (formerly Sendinblue)
BREVO_API_KEY=your_brevo_api_key

# Option 4: Resend (Easiest to set up)
RESEND_API_KEY=re_your_resend_api_key

# Option 5: Gmail SMTP (Not recommended - blocked on many hosts)
EMAIL_PASS=your_gmail_app_password

# ===================================
# AI/CHATBOT (Groq)
# ===================================
GROQ_API_KEY=gsk_your_groq_api_key

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
NODE_ENV=development

# ===================================
# CORS CONFIGURATION
# ===================================
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=https://your-production-domain.com

# ===================================
# NOTES
# ===================================
# 1. NEVER commit the actual .env file to git
# 2. Keep .env in .gitignore
# 3. Rotate all keys if accidentally exposed
# 4. Use different keys for development and production
